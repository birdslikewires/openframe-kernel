--- /dev/null
+++ b/drivers/iio/light/openframe-als.c
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * OpenFrame ambient light sensor
+ *
+ * The OpenFrame 1 (O2 Joggler) reads the light sensor on its top through a device at
+ * 0x34 on the SCH SMBus. One reading: an SMBus block write of command 0x27 with two
+ * zero bytes asks for it, then a block read of command 0x27 returns 0x87 followed by
+ * the reading, low byte first (worked out from OpenPeak's readlightsensor). The device
+ * answers on the first read, about 2 ms a reading. Nothing else is ever sent to it:
+ * what else it does isn't known. The reading has no known unit, so it's published raw.
+ *
+ * Nothing describes the device to the kernel, so userspace creates it (openframe-scripts
+ * does, from a udev rule):
+ *   echo openframe-als 0x34 > /sys/bus/i2c/devices/i2c-0/new_device
+ */
+
+#include <linux/bits.h>
+#include <linux/cleanup.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/iio/iio.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+
+#define OFALS_CMD	0x27
+#define OFALS_READY	0x87
+#define OFALS_POLLS	20
+
+struct ofals {
+	struct i2c_client *client;
+	struct mutex lock;	/* one request and its reply at a time */
+};
+
+static int ofals_read(struct ofals *als, int *val)
+{
+	static const u8 req[2] = { 0, 0 };
+	u8 buf[I2C_SMBUS_BLOCK_MAX];
+	int ret, i;
+
+	guard(mutex)(&als->lock);
+
+	ret = i2c_smbus_write_block_data(als->client, OFALS_CMD, sizeof(req), req);
+	if (ret < 0)
+		return ret;
+
+	for (i = 0; i < OFALS_POLLS; i++) {
+		ret = i2c_smbus_read_block_data(als->client, OFALS_CMD, buf);
+		if (ret < 0)
+			return ret;
+		if (ret >= 3 && buf[0] == OFALS_READY) {
+			*val = buf[1] | (buf[2] << 8);
+			return 0;
+		}
+		usleep_range(1000, 2000);
+	}
+
+	return -ETIMEDOUT;
+}
+
+static int ofals_read_raw(struct iio_dev *indio_dev, struct iio_chan_spec const *chan,
+			  int *val, int *val2, long mask)
+{
+	struct ofals *als = iio_priv(indio_dev);
+	int ret;
+
+	if (mask != IIO_CHAN_INFO_RAW)
+		return -EINVAL;
+
+	ret = ofals_read(als, val);
+	if (ret)
+		return ret;
+
+	return IIO_VAL_INT;
+}
+
+static const struct iio_info ofals_info = {
+	.read_raw = ofals_read_raw,
+};
+
+static const struct iio_chan_spec ofals_channels[] = {
+	{
+		.type = IIO_LIGHT,
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),
+	},
+};
+
+static int ofals_probe(struct i2c_client *client)
+{
+	struct iio_dev *indio_dev;
+	struct ofals *als;
+	int val, ret;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_SMBUS_BLOCK_DATA))
+		return -EOPNOTSUPP;
+
+	indio_dev = devm_iio_device_alloc(&client->dev, sizeof(*als));
+	if (!indio_dev)
+		return -ENOMEM;
+
+	als = iio_priv(indio_dev);
+	als->client = client;
+	ret = devm_mutex_init(&client->dev, &als->lock);
+	if (ret)
+		return ret;
+
+	/* A reading first, so a unit without the device doesn't get a sensor. */
+	ret = ofals_read(als, &val);
+	if (ret)
+		return dev_err_probe(&client->dev, ret, "no reply from the light sensor\n");
+
+	indio_dev->name = "openframe-als";
+	indio_dev->info = &ofals_info;
+	indio_dev->channels = ofals_channels;
+	indio_dev->num_channels = ARRAY_SIZE(ofals_channels);
+	indio_dev->modes = INDIO_DIRECT_MODE;
+
+	return devm_iio_device_register(&client->dev, indio_dev);
+}
+
+static const struct i2c_device_id ofals_id[] = {
+	{ "openframe-als" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, ofals_id);
+
+static struct i2c_driver ofals_driver = {
+	.driver = {
+		.name = "openframe-als",
+	},
+	.probe = ofals_probe,
+	.id_table = ofals_id,
+};
+module_i2c_driver(ofals_driver);
+
+MODULE_DESCRIPTION("OpenFrame ambient light sensor");
+MODULE_LICENSE("GPL");
