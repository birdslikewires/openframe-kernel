+/*
+ * OpenFrame: how many spatial streams to send with. The OpenFrame 2's
+ * BCM43225 receives two streams cleanly, but most of its two-stream
+ * transmissions (MCS 8-15) fail, rate control keeps trying them, and the
+ * link stalls or drops; sending on one stream (MCS 0-7) works. Receiving
+ * stays two streams. 2 is the driver's own behaviour.
+ */
+static uint brcms_tx_streams = 1;
+module_param_named(tx_streams, brcms_tx_streams, uint, 0444);
+MODULE_PARM_DESC(tx_streams, "Spatial streams to send with on N-PHY cards (1 or 2, default 1)");
+
